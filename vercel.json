{
  "version": 2,
  "name": "brucedavis-enterprise",
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "lab/**",
      "use": "@vercel/static"
    },
    {
      "src": "videos/**",
      "use": "@vercel/static"
    },
    {
      "src": "demos/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "fonts/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/recruiter.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 20
      }
    }
  ],
  "routes": [
    {
      "src": "/api/recruiter",
      "dest": "/api/recruiter.mjs"
    },
    {
      "src": "/api/(.*)",
      "status": 404
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/_archive/(.*)",
      "status": 404
    },
    {
      "src": "/six-percent-playground.html",
      "status": 301,
      "headers": {
        "Location": "/001-physics-playground.html"
      }
    },
    {
      "src": "/playground",
      "dest": "/001-physics-playground.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

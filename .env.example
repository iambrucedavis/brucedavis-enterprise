# Set actual values in Vercel Settings > Environment Variables, scoped to the
# review branch's Preview environment first. Never put values in browser code.
OPENAI_API_KEY=
# Choose an account-accessible Responses model supporting strict JSON schema.
OPENAI_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A fresh random secret of at least 32 characters, configured only server-side.
ASSISTANT_RATE_LIMIT_SECRET=
# Optional conservative ceilings; quotas use UTC calendar days.
ASSISTANT_VISITOR_PER_MINUTE=5
ASSISTANT_VISITOR_PER_DAY=20
ASSISTANT_GLOBAL_CALLS_PER_DAY=50
ASSISTANT_GLOBAL_TOKEN_ALLOWANCE=200000
ASSISTANT_MAX_CONCURRENT=2
